<div id="post-content" class="prose lg:prose-xl">
    {%- for service in collections.service -%}
    <div class="bg-white rounded-lg shadow-lg overflow-hidden mb-8">
        <figure>
            {% Image service.data.img, service.data.alt_image, "w-full" %}
        </figure>
        <div class="p-6">
            <h3 class="text-2xl font-bold mb-2">{{ service.data.title }}</h3>
            <p class="text-gray-700 text-base">{{ service.content | strip_html }}</p>
        </div>
    </div>
    {%- endfor -%}
</div>

